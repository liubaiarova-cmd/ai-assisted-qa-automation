# Copy to `.env` in the repo root and fill in values. Never commit `.env`.
# Playwright loads this file via `playwright.config.ts` (dotenv).

# -----------------------------------------------------------------------------
# Run tests (required to clone and run Playwright)
# -----------------------------------------------------------------------------

# Base URL of the Didaxis environment under test (also Playwright baseURL).
DIDAXIS_URL=https://test.didaxis.studio

# Primary admin (or default) account used by auth setup and most specs.
DIDAXIS_EMAIL=you@example.com

DIDAXIS_PASSWORD=your-password-here

# Bearer JWT for API cleanup (DELETE /api/programs). Obtain from a valid session; rotate before expiry.
DIDAXIS_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Optional: second account for permission / non-admin probes in DS specs.
# Existing tests read DIDAXIS_NON_ADMIN_EMAIL and DIDAXIS_NON_ADMIN_PASSWORD — set those names to the same values if you use this alt pair.
DIDAXIS_ALT_EMAIL=nonadmin@example.com
DIDAXIS_ALT_PASSWORD=nonadmin-password-here

# -----------------------------------------------------------------------------
# Agent / CI setup (not needed for `npx playwright test` alone)
# -----------------------------------------------------------------------------

# Cursor CLI / headless agent in .github/workflows/test-generation.yml (and similar).
CURSOR_API_KEY=cur_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian API token (https://id.atlassian.com/manage-profile/security/api-tokens) with Jira access.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira/Confluence site root (no trailing slash), e.g. for MCP and REST calls.
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN for Basic auth (Jira REST, workflow steps).
ATLASSIAN_EMAIL=you@example.com
